# OS / editor clutter
.DS_Store
Thumbs.db
desktop.ini
.vscode/
*.swp

# Local env files (never commit secrets)
.env
.env.*

# Node tooling, if ever used locally (the app itself has no build step)
node_modules/
npm-debug.log*
# Chromium diagnostic output from local browser verification
debug.log
# Reproducible browser screenshots are local evidence, not submission assets.
verification/*.png
!verification/checkpoint-4-wardrobe.png
!verification/checkpoint-4-card.png
# Keep generated release archives and staging folders out of the source tree.
.release/
*.zip

# Raw / working art files — commit only the final exported assets
assets/_raw/
